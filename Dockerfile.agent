# syntax=docker/dockerfile:1
# check=error=true

ARG GO_VERSION=1.26
ARG DEBIAN_VERSION=trixie

FROM --platform=$BUILDPLATFORM docker.io/library/golang:$GO_VERSION AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /agent
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
COPY .release-please-manifest.json /agent/
RUN version=$(sed -n 's/.*"\.": *"\([^"]*\)".*/\1/p' .release-please-manifest.json) && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X main.version=${version:-dev}" -o /out/xixo-agent .

FROM docker.io/library/debian:$DEBIAN_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates libvips-tools libraw-bin libimage-exiftool-perl libarchive-zip-perl poppler-utils \
      tesseract-ocr ffmpeg libreoffice-writer libreoffice-calc fonts-liberation && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

RUN groupadd --system --gid 1000 agent && \
    useradd agent --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin && \
    mkdir -p /var/lib/xixo-agent /handoff /data/files && \
    chown agent:agent /var/lib/xixo-agent /handoff /data/files && \
    chmod 700 /var/lib/xixo-agent

COPY --from=build /out/xixo-agent /usr/local/bin/xixo-agent
COPY bin/agent-entrypoint /usr/local/bin/agent-entrypoint

USER 1000:1000
ENV HOME=/home/agent

ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
CMD ["xixo-agent", "run", "--config", "/var/lib/xixo-agent/config.json", "--state", "/var/lib/xixo-agent"]
