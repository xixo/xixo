# Every variable is described in docs/src/content/docs/reference/environment.mdx.

# Stops every sync, analysis, export, and reindex in every tenant.
XIXO_ITERATORS_DISABLED=

# Where git resources keep their clones. Unset, git resources are unusable.
XIXO_GIT_ROOT=

# The transports git may use. Adding ext lets a resource run a command, and file lets it read
# any repository on the server's disk.
XIXO_GIT_PROTOCOLS=https

# How many seconds from the start of a recording are transcribed.
XIXO_TRANSCRIBE_SECONDS=3600

# The Chrome or Chromium that renders snapshots. Unset, xixo looks in the usual places.
XIXO_CHROME_PATH=

# Turns off Chrome's sandbox. Set it only where the container cannot give Chrome the namespaces
# its sandbox needs.
XIXO_CHROME_NO_SANDBOX=

# The length of the vectors the search index holds. The embedding model must return vectors of
# this length.
XIXO_EMBEDDING_DIMENSIONS=768

# Development values. Generate your own with bin/rails db:encryption:init before you store real
# credentials.
ENCRYPTION_PRIMARY_KEY=dev_only_primary_key_not_for_real_credentials
ENCRYPTION_DETERMINISTIC_KEY=dev_only_deterministic_key_not_for_real_use
ENCRYPTION_KEY_DERIVATION_SALT=dev_only_key_derivation_salt_not_for_real

XIXO_PUBLIC_ORIGIN=
