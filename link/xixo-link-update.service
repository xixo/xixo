[Unit]
Description=xixo link update
Documentation=https://github.com/xixo/xixo/tree/main/link

[Service]
Type=oneshot
ExecStart=/usr/local/lib/xixo-link/xixo-link update --config /etc/xixo-link/config.json --requests /run/xixo-link --results /run/xixo-link-update
TimeoutStartSec=15min
RuntimeDirectory=xixo-link-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/lib/xixo-link /etc/systemd/system
ProtectHome=yes
InaccessiblePaths=-/var/lib/xixo-link -/var/cache/xixo-link -/var/lib/xixo-link-part
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
