[Unit]
Description=xixo link update
Documentation=https://github.com/xixo/xixo/tree/main/link
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xixo-link-update
Group=xixo-link-update
ExecStart=/usr/local/lib/xixo-link/xixo-link update --config /etc/xixo-link/config.json --requests /run/xixo-link
TimeoutStartSec=15min
RuntimeDirectory=xixo-link-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/lib/xixo-link
ProtectHome=yes
InaccessiblePaths=-/var/lib/xixo-link -/var/cache/xixo-link
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
