[Unit]
Description=xixo link update download
Documentation=https://github.com/xixo/xixo/tree/main/link
Wants=network-online.target
After=network-online.target
OnSuccess=xixo-link-update.service
OnFailure=xixo-link-update.service

[Service]
Type=oneshot
DynamicUser=yes
CacheDirectory=xixo-link-update
CacheDirectoryMode=0755
ExecStart=/usr/local/lib/xixo-link/xixo-link fetch --config /etc/xixo-link/config.json --requests /run/xixo-link --cache /var/cache/xixo-link-update
TimeoutStartSec=15min
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/xixo-link -/var/cache/xixo-link -/var/lib/xixo-link-part
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
