[Unit]
Description=xixo link
Documentation=https://github.com/xixo/xixo/tree/main/link
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=@USER@
ExecStart=/usr/local/lib/xixo-link/xixo-link run --config /etc/xixo-link/config.json --state /var/lib/xixo-link --updates systemd
Restart=always
RestartSec=5
RestartPreventExitStatus=78
StateDirectory=xixo-link
StateDirectoryMode=0700
RuntimeDirectory=xixo-link
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
ConfigurationDirectory=xixo-link
CacheDirectory=xixo-link
CacheDirectoryMode=0700
MemoryMax=2G
OOMPolicy=continue
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=/srv:ro /mnt:ro /media:ro /opt:ro /var/lib:ro
@FOLDERS@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=setrlimit
SystemCallErrorNumber=EPERM
PrivateUsers=yes
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
