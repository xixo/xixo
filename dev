#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "securerandom"
require "shellwords"
require "time"

ROOT = __dir__

APP_PORT = ENV.fetch("URIS_PORT", "8180")
DOCS_PORT = ENV.fetch("URIS_DOCS_PORT", "8181")

USAGE = <<~TEXT
  usage: dev [command] [--multi]

    up             build and run the stack in the foreground
    down           stop it, keeping the volumes
    reset          throw the volumes away and start over
    logs [service] follow one service, or all of them
    ps             what is running
    psql           a shell on postgres
    console        a rails console
    seed           re-run the seeds
    corpus [group] load the reference corpus and analyse what comes back
    asks [ids]     ask the eval questions against the asks fixtures and score the answers
    test [suite]   unit, server, client, corpus
    reference      regenerate the reference pages under docs/ from the code
    delegation     connect an MCP server through masks and put the whole flow through its paces
    fmt [--check]  format everything, or check it

  One tenant answers at http://uris.localhost:#{APP_PORT}, its docs at
  http://uris.localhost:#{DOCS_PORT}. It authenticates against masks, which
  MASKS_ISSUER names and which has to be running for sign-in to work.
TEXT

def die(message)
  warn message
  exit 1
end

def usage
  warn USAGE
  exit 64
end

def run(*command, chdir: ROOT)
  system(*command, chdir: chdir)
end

def run!(*command, chdir: ROOT)
  run(*command, chdir: chdir) || die("failed: #{command.shelljoin}")
end

def compose(*args, multi: false)
  files = [ "compose.yml", *("compose.multi.yml" if multi) ]

  [ "docker", "compose", *files.flat_map { |file| [ "-f", file ] }, *args ]
end

def announce(multi)
  hosts = multi ? %w[demo acme].map { |t| "#{t}.uris.localhost" } : [ "uris.localhost" ]

  puts
  hosts.each { |host| puts "  uris    http://#{host}:#{APP_PORT}" }
  puts "  docs    http://uris.localhost:#{DOCS_PORT}"
  puts
end

def up(multi)
  announce(multi)
  run!(*compose("up", "--build", "--abort-on-container-failure", multi: multi))
end

SUITES = %w[unit server corpus].freeze

UNPINNED = [ "-e", "URIS_TENANT=", "-e", "URIS_TENANTS=" ].freeze

def suite(name, multi)
  return run(*compose("exec", "-T", "uris", "npm", "test", multi: multi)) if name == "client"

  run(*compose("exec", "-T", *UNPINNED, "uris", "bin/rails", "test", "test/#{name}", multi: multi))
end

def test(names, multi)
  names = SUITES + [ "client" ] if names.empty?
  names.each { |name| usage unless SUITES.include?(name) || name == "client" }

  run!(*compose("up", "-d", "--wait", "uris", multi: multi))
  run!(*compose("exec", "-T", *UNPINNED, "uris", "bin/rails", "db:test:prepare", multi: multi))

  failed = names.reject do |name|
    puts "\n== #{name}\n\n"
    suite(name, multi)
  end

  die("\nfailed: #{failed.join(' ')}") if failed.any?
  puts "\npassed: #{names.join(' ')}"
end

MASKS_CONTAINER = ENV.fetch("MASKS_CONTAINER", "masks-masks-1")
MCP_OAUTH_PORT = ENV.fetch("URIS_MCP_OAUTH_PORT", "8190")

def delegation_env
  @delegation_env ||= {
    "DELEGATION_URIS" => "http://uris.localhost:#{APP_PORT}",
    "DELEGATION_ISSUER" => ENV.fetch("MASKS_ISSUER", "http://masks.localhost:12345"),
    "DELEGATION_SERVER" => "http://mcp.localhost:#{MCP_OAUTH_PORT}",
    "DELEGATION_PASSWORD" => SecureRandom.hex(16),
    "DELEGATION_PEOPLE" => "ada,bob"
  }
end

def passes(what, held)
  die("  ✗ #{what}") unless held
  puts "  ✓ #{what}"
end

def in_masks
  flags = delegation_env.merge("DELEGATION_TENANT" => ENV.fetch("MASKS_TENANT", "masks"))
                        .flat_map { |name, value| [ "-e", "#{name}=#{value}" ] }
  script = File.read(File.join(ROOT, "script/delegation/masks.rb"))

  run!("docker", "exec", *flags, MASKS_CONTAINER, "bin/rails", "runner", script)
end

def in_uris(step)
  output, status = Open3.capture2(
    *compose("exec", "-T", "-e", "DELEGATION_STEP=#{step}",
             "-e", "DELEGATION_TENANT=#{ENV.fetch('URIS_TENANT', 'uris')}",
             "uris", "bin/rails", "runner", "script/delegation/uris.rb"),
    chdir: ROOT
  )
  die("failed: uris #{step}\n#{output}") unless status.success?

  line = output.lines.last
  line && line.start_with?("{") ? JSON.parse(line) : {}
end

def driven(*step)
  output, status = Open3.capture2(delegation_env, "node", "script/delegation/run.mjs", *step, chdir: ROOT)
  die("failed: #{step.join(' ')}") unless status.success?

  JSON.parse(output.lines.last)
end

def settle(seconds)
  deadline = Time.now + seconds

  loop do
    found = yield
    return found if found || Time.now > deadline

    sleep 3
  end
end

def until_uris_asks_masks_again
  stale = Time.at(in_uris("state")["expires_at"].to_i - 60)
  sleep([ stale - Time.now + 1, 0 ].max)
end

def delegation
  run!(*compose("up", "-d", "--wait", "uris", "uris-worker", "mcp-oauth"))
  run!("npx", "playwright", "install", "chromium")

  puts "\n== masks registers with the stand-in, and ada and bob can sign in\n\n"
  in_masks
  in_uris("forget")

  puts "\n== ada attaches the stand-in for herself and connects it through masks\n\n"
  row = driven("connect")["row"]
  passes("it comes back reachable and only hers: #{row}", row.include?("reachable") && row.include?("only you"))

  state = in_uris("state")
  passes("uris holds a delegation and a cached upstream token, and nothing typed in",
         state["holds"] == %w[delegation upstream])

  puts "\n== over MCP, as ada and then as bob\n\n"
  ada = driven("mcp", "ada", "65")
  passes("ada is offered stand-in__whoami", ada["offered"] == [ "stand-in__whoami" ])
  passes("it answers with her account: #{ada['said']}", ada["said"] == "called by ada")
  passes("past the upstream token's lifetime it still answers: #{ada['later']}", ada["later"] == "called by ada")

  bob = driven("mcp", "bob")
  passes("bob is offered none of its tools", bob["offered"].empty?)
  passes("and calling one by name is refused", bob["said"].start_with?("refused"))

  puts "\n== with nobody signed in, the worker checks it from the kept secret alone\n\n"
  until_uris_asks_masks_again
  run!(*compose("restart", "uris-worker"))
  before = in_uris("state")
  in_uris("due")
  after = settle(90) do
    now = in_uris("state")
    now if now["checked_at"] != before["checked_at"] && Time.parse(now["checked_at"]) > Time.now - 120
  end
  passes("the scheduled check ran", after)
  passes("masks released a fresh upstream token", after["expires_at"].to_i > before["expires_at"].to_i)
  passes("and it still counts as connected", !after["needs_connect"])

  puts "\n== ada stops uris using her account from the masks account page\n\n"
  driven("revoke", "ada")
  passes("the upstream token uris already holds still answers until it lapses",
         in_uris("call")["said"] == "called by ada")
  until_uris_asks_masks_again
  called = in_uris("call")
  passes("then the next call is refused: #{called['message']}", called["refused"] == "Resource::Unusable")
  state = in_uris("state")
  passes("uris keeps only the delegation, and marks it for reconnecting",
         state["needs_connect"] && state["holds"] == %w[delegation])
  row = driven("listed", "ada")["row"]
  passes("her resource list offers Reconnect: #{row}", row.include?("Reconnect"))

  puts "\npassed: delegation"
end

def fmt(args)
  usage unless args.empty? || args == [ "--check" ]
  check = args.first == "--check"

  %w[shfmt shellcheck].each do |tool|
    next if system("command -v #{tool} > /dev/null")

    die("#{tool} is not on your PATH, and CI checks with it. brew bundle")
  end

  scripts = Dir.chdir(ROOT) { `shfmt -f bin script`.split("\n") }

  ok = [
    run("bin/rubocop", *(check ? [] : [ "-a" ])),
    run("npx", "biome", "check", *([ "--write" ] unless check)),
    run("npx", "--yes", "prettier@3.9.6", check ? "--check" : "--write",
        "--no-error-on-unmatched-pattern",
        "*.{yml,yaml,md}", ".github/**/*.{yml,yaml}", "config/**/*.{yml,yaml}"),
    run("shfmt", check ? "-d" : "-w", "-i", "2", "-ci", *scripts),
    run("shellcheck", *scripts)
  ]

  exit(ok.all? ? 0 : 1)
end

command = ARGV.first == "--multi" ? "up" : ARGV.shift || "up"
multi = !ARGV.delete("--multi").nil?

case command
when "up" then up(multi)
when "down" then run!(*compose("down", multi: multi))
when "reset"
  run!(*compose("down", "-v", "--remove-orphans", multi: multi))
  up(multi)
when "logs" then run!(*compose("logs", "-f", *ARGV, multi: multi))
when "ps" then run!(*compose("ps", multi: multi))
when "psql" then run!(*compose("exec", "postgres", "psql", "-U", "postgres", multi: multi))
when "console" then run!(*compose("exec", "uris", "bin/rails", "console", multi: multi))
when "seed" then run!(*compose("exec", "-T", "uris", "bin/rails", "db:seed", multi: multi))
when "corpus"
  tenant = ENV.fetch("URIS_TENANT", "uris")
  run!(*compose("exec", "-T", "-e", "CORPUS_TENANT=#{tenant}", "-e", "CORPUS_GROUP=#{ARGV.first}",
                "uris", "bin/rails", "runner", "script/corpus.rb", multi: multi))
when "asks"
  passed = %w[ASKS_FRESH ASKS_KEEP ASKS_AGAINST ASKS_TIMEOUT].flat_map { |name| [ "-e", "#{name}=#{ENV[name]}" ] }
  run!(*compose("exec", "-T", *UNPINNED, "-e", "ASKS_ONLY=#{ARGV.join(',')}", *passed,
                "uris", "bin/rails", "runner", "script/asks.rb", multi: multi))
when "test" then test(ARGV, multi)
when "reference"
  run!(*compose("up", "-d", "--wait", "uris", multi: multi))
  run!(*compose("exec", "-T", *UNPINNED, "uris", "bin/rails", "docs:reference", multi: multi))
when "delegation" then delegation
when "fmt" then fmt(ARGV)
else usage
end
